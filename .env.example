# Copy to .env (never commit .env). One environment: local dev uses the same
# Firestore database and bucket as the deployed app.
PHOTON_GCP_PROJECT=arctic-sound-380822
PHOTON_GCP_REGION=europe-west4
PHOTON_FIRESTORE_DB=photon
PHOTON_BUCKET=arctic-sound-380822-photon
# dev only: serve /data from this local folder instead of the bucket
PHOTON_LOCAL_DATA=data
# local URL (OAuth redirect); the deployed URL comes from PHOTON_PUBLIC_URL
PHOTON_BASE_URL=http://localhost:5173
PHOTON_PUBLIC_URL=https://photon.daviddenuyl.com
# gcloud configuration for deploy.py and scripts/sync_data.py (owner account)
PHOTON_GCLOUD_CONFIG=zgr
# accounts that may log in (comma-separated); personal photos, nobody else
PHOTON_ALLOWED_EMAILS=
# shared Google OAuth client (secret: Secret Manager `denarius-oauth-client-secret`)
PHOTON_OAUTH_CLIENT_ID=
PHOTON_OAUTH_CLIENT_SECRET=
PHOTON_SESSION_SECRET=
